}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1782487178.6568232, 'supported_languages': None}, 'macro.dbt_snowflake.snowflake__diff_column_data_types': {'name': 'snowflake__diff_column_data_types', 'resource_type': 'macro', 'package_name': 'dbt_snowflake', 'path': 'macros/materializations/models/incremental/snowflake_column_helpers.sql', 'original_file_path': 'macros/materializations/models/incremental/snowflake_column_helpers.sql', 'unique_id': 'macro.dbt_snowflake.snowflake__diff_column_data_types', 'macro_sql': '{% macro snowflake__diff_column_data_types(source_columns, target_columns) %}\n\n  {#\n    Snowflake COLLATE is not something dbt should attempt to "remove" via\n    `ALTER COLUMN ... SET DATA TYPE ...` during incremental schema change sync.\n    If the target column already has a collation, preserve it in any emitted\n    `new_type` so we don\'t drop it unintentionally.\n  #}\n\n  {%- set result = [] -%}\n  {%- for sc in source_columns -%}\n    {%- set tc = target_columns | selectattr("name", "equalto", sc.name) | list | first -%}\n    {%- if tc -%}\n      {# Compare base type only (ignore collation differences). #}\n      {%- if sc.data_type != tc.data_type and not sc.can_expand_to(other_column=tc) -%}\n        {%- set new_type = sc.data_type -%}\n\n        {# If the existing target column has a collation, keep it. #}\n        {%- if tc.collation is defined and tc.collation -%}\n          {%- set new_type = new_type ~ " collate \'" ~ tc.collation ~ "\'" -%}\n        {%- endif -%}\n\n        {%- do result.append({\'column_name\': tc.name, \'new_type\': new_type}) -%}\n      {%- endif -%}\n    {%- endif -%}\n  {%- endfor -%}\n\n  {{- return(result) -}}\n\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': No