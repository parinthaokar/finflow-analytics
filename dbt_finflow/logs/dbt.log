OURCE\n        on FALSE\n\n    when not matched by source\n        {% if predicates %} and {{ predicates | join(\' and \') }} {% endif %}\n        then delete\n\n    when not matched then insert\n        ({{ dest_cols_csv }})\n    values\n        ({{ dest_cols_csv }})\n\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt.get_quoted_csv']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1781724056.508039, 'supported_languages': None}, 'macro.dbt.is_incremental': {'name': 'is_incremental', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/materializations/models/incremental/is_incremental.sql', 'original_file_path': 'macros/materializations/models/incremental/is_incremental.sql', 'unique_id': 'macro.dbt.is_incremental', 'macro_sql': "{% macro is_incremental() %}\n    {#-- do not run introspective queries in parsing #}\n    {% if not execute %}\n        {{ return(False) }}\n    {% else %}\n        {% set relation = adapter.get_relation(this.database, this.schema, this.table) %}\n        {{ return(relation is not none\n                  and relation.type == 'table'\n                  and model.config.materialized == 'incremental'\n                  and not should_full_refresh()) }}\n    {% endif %}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.should_full_refresh']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1781724056.508419, 'supported_languages': None}, 'macro.dbt.get_incremental_append_sql': {'name': 'get_incremental_append_sql', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/materializations/models/incremental/strategies.sql', 'original_file_path': 'macros/materializations/models/incremental/strategies.sql', 'unique_id': 'macro