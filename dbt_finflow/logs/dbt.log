ue_key, identifier, from_identifier) %}\n    {% if unique_key | is_list %}\n        {% for key in unique_key %}\n\t    {% set source_unique_key = (identifier ~ ".dbt_unique_key_" ~ loop.index) | trim %}\n\t    {% set target_unique_key = (from_identifier ~ ".dbt_unique_key_" ~ loop.index) | trim %}\n\t    {{ equals(source_unique_key, target_unique_key) }}\n            {%- if not loop.last %} and {%- endif %}\n        {% endfor %}\n    {% else %}\n        {{ identifier }}.dbt_unique_key = {{ from_identifier }}.dbt_unique_key\n    {% endif %}\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt.equals']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1782487178.698325, 'supported_languages': None}, 'macro.dbt.unique_key_is_null': {'name': 'unique_key_is_null', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/materializations/snapshots/helpers.sql', 'original_file_path': 'macros/materializations/snapshots/helpers.sql', 'unique_id': 'macro.dbt.unique_key_is_null', 'macro_sql': '{% macro unique_key_is_null(unique_key, identifier) %}\n    {% if unique_key | is_list %}\n        {{ identifier }}.dbt_unique_key_1 is null\n    {% else %}\n        {{ identifier }}.dbt_unique_key is null\n    {% endif %}\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1782487178.6984692, 'supported_languages': None}, 'macro.dbt.unique_key_is_not_null': {'name': 'unique_key_is_not_null', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/materializations/snapshots/helpers.sql', 'original_file_path': 'macros/materializations/snapshots/helpers.sql', 'unique_id': 'macro.dbt.unique_key_is_not_null', 'macro_sql': '{% macro unique_key_