         as
        (with step_one as (
    SELECT * from FINFLOW.SILVER_SILVER.stg_transactions
),
final as (
select user_id, count(transaction_id) as Total_Transactions, avg(amount) as Average_Transaction_Amount, max(amount) as max_transaction_amount, 
