ion': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1781668637.112491, 'supported_languages': None}, 'macro.dbt.default__copy_grants': {'name': 'default__copy_grants', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/adapters/apply_grants.sql', 'original_file_path': 'macros/adapters/apply_grants.sql', 'unique_id': 'macro.dbt.default__copy_grants', 'macro_sql': '{% macro default__copy_grants() %}\n    {{ return(True) }}\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1781668637.112629, 'supported_languages': None}, 'macro.dbt.support_multiple_grantees_per_dcl_statement': {'name': 'support_multiple_grantees_per_dcl_statement', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/adapters/apply_grants.sql', 'original_file_path': 'macros/adapters/apply_grants.sql', 'unique_id': 'macro.dbt.support_multiple_grantees_per_dcl_statement', 'macro_sql': "{% macro support_multiple_grantees_per_dcl_statement() %}\n    {{ return(adapter.dispatch('support_multiple_grantees_per_dcl_statement', 'dbt')()) }}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt_snowflake.snowflake__support_multiple_grantees_per_dcl_statement']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1781668637.112732, 'supported_languages': None}, 'macro.dbt.default__support_multiple_grantees_per_dcl_statement': {'name': 'default__support_multiple_grantees_per_dcl_statement', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/adapters/apply_grants.sql', 'original_file_path': 'macros/adapters/apply_gra